# Supabase — client-safe ANON key only. NEVER put the service-role key or DB
# password in a VITE_*-prefixed variable (it ships to the browser).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: self-host the ffmpeg core so exports don't depend on the bundled
# asset. Falls back to the in-repo core when unset.
# VITE_FFMPEG_CORE_URL=
